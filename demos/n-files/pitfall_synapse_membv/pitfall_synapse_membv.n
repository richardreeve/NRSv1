// Experiment to show pitfall of trying to set membV for a synapse

#include <defines.n>

Network System
{  
  SetParams
    {
      // Speed up the simulation by using a larger step size
      stepT = 1 ms;
    }
 
  /* ------------------------------------------------------------------ */
  /* FACTORY SETTINGS                                                   */
  /*                                                                    */
  /* To get nice output data, set the following parameter / value pairs */
  /*                                                                    */
  /*     stepT = 1 ms;                                                  */
  /*     membC_coeff = 5;                                               */
  /*     Time = 1 s;                                                    */
  /*                                                                    */
  /*     expSynT = 100 ms;                                              */
  /*     evSynV = -60 mV;                                               */
  /*     vSynG = 4 nS;                                                  */
  /*                                                                    */
  /* ------------------------------------------------------------------ */

  int membC_coeff = 5;

  // Spike source
  add neuron preN Spiking
    {
      membV = 0 mV;
      threshV = -1 mV;
      recovV = -40 mV;
      
      membG = 5 nS;
      membC = membC_coeff * 10 pF;
    }  

  add neuron postN Spiking
    {
      threshV = 0 mV;

      // postN neuron has a default resting potential of -80mv
    }

  add synapse
    {
      syn ConductanceBased excitatory from preN to postN delay 50
        {
          /* default values */
          expSynT = 100 ms;
          evSynV = -60 mV;
          vSynG = 4 nS;

          membV = 200 mV;
        }
    }  
}


Experiment
{
  Time = 1 s;

  printf("pitfall_synapse_membv.n demo script loaded\n");
  
  // Output lots of information
  output_level = output_input | output_spike | output_membV;

  Save
  {
    Level = output_level;
    Start("~/data/pitfall_synapse_membv");
  }

  printf("Running experiment...\n\n");
  Run;
  wait;
  printf("\nExperiment completed\n--------------------\n");
  printf("Use the nodeHelper.linux tool to convert the\n");
  printf("output data to text format for viewing.\n\n");

  printf("WHAT YOU SHOULD SEE\n");
  printf("This demo should show you that the membV parameter for conduct-\n");
  printf("ance based synapses has no use.  In the n-file, the membV for\n");
  printf("the synapse is set to 200 mV, but the output still shows the \n");
  printf("PSP being pulled to -60 mV, which is the reversal potential of\n");
  printf("the synapse.  Also if you look in the n-file which gets auto-\n");
  printf("matically generated, the membV setting for the synapse does\n");
  printf("not appear.\n");


}

