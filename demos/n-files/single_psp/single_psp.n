// Experiment to have a single post-synaptic potential

#include <defines.n>

Network System
{  
  SetParams
    {
      // Speed up the simulation by using a larger step size
      stepT = 1 ms;
    }
 

  add neuron preN SpikeSource
    {
      spikeTime = 100 ms;
    }  

  add neuron postN Spiking
    {
      threshV = 0 mV;
    }

  add synapse
    {
      // An inhibitory synapse
      iSyn5 ConductanceBased inhibitory from preN to postN delay 5
        {
          /* default values */
          expSynT = 50 ms;
      }
    }  

  // An excitatory synaspe
  add synapse
    {
      eSyn300 ConductanceBased excitatory from preN to postN delay 300
        {
          expSynT = 50ms;
          vSynG = 1 nS;
        }
    }  
  
  // A non-specific synapse
  add synapse
    {
      gSyn600 ConductanceBased from preN to postN delay 600
        {
          expSynT = 50ms;
          vSynG = 2 nS;
          gvSynV = 40 mV;
        }
    }  
}


Experiment
{
  Time = 1 s;

  printf("single_psp.n demo script loaded\n");
  
  // Output lots of information
  output_level = output_input | output_spike | output_membV;

  Save
  {
    Level = output_level;
    Start("~/data/single_psp");
  }

  printf("Running experiment...\n\n");
  Run;
  wait;
  printf("\nExperiment completed\n--------------------\n");
  printf("Use the nodeHelper.linux tool to convert the\n");
  printf("output data to text format for viewing.\n\n");
}

