// Experiment to demonstrate a ModulatorySynapse.

// All that happens is that a modulatory synapse receives a spike, and
// so illicitis an output.

#include <defines.n>

Network System
{  
  SetParams
    {
      // Speed up the simulation by using a larger step size
      stepT = 1 ms;
    }
 
  /* ------------------------------------------------------------------ */
  /* FACTORY SETTINGS                                                   */
  /*                                                                    */
  /* To get nice output data, set the following parameter / value pairs */
  /*                                                                    */
  /*     THERE ARE NO SPECIAL SETTINGS                                  */
  /*                                                                    */
  /* ------------------------------------------------------------------ */

  // This is the CS (Conditioned Stimulus) pathway.  Three spikes are
  // produced.  The first is a pre-training test, the second is the
  // training, and the third is the post-training test
  add neuron cs SpikeSource
    {
      spikeTime = 0 ms;
    }

  // This represents the US (Unconditioned Stimulus) which does the
  // synaptic reinforcement (sensitization and conditioning)
  add neuron us SpikeSource
    {
      spikeTime = 300 ms;
    }
  
  // Effects of synaptic reinforcement will be observed in the change in
  // depolarisation of this postsynapse neuron.
  add neuron postN Spiking
    {
      /* defaults

      membC = 10 pF
      membG = 5 nS
      */

      membC = 10 pF;
      membG = 5 nS;
    }

  // Synapse carrying CS information which will undergoe modification.
  add synapse cond_syn ConditionableSynapse from cs to postN delay 50
    {
      facDecayT = 1000 mS;
    }

  // Synapse carrying US information and will reinforce the CS pathway.
  add synapse mod_syn ModulatorySynapse from us to cond_syn delay 50
    {
      mModStr = 0.5 nS;
    }

}


Experiment
{
  Time = 1 s;

  printf("mod_synapse.n demo script loaded\n");
  
  // Output lots of information
  output_level = output_input | 
                 output_spike |
    //                 output_membV | 
    output_synapse;
    //		 output_facdep;

  Save
  {
    Level = output_level;
    Start("~/data/mod_synapse");
  }

  printf("Running experiment...\n\n");
  Run;
  wait;
  printf("\nExperiment completed\n--------------------\n");
  printf("Use the nodeHelper.linux tool to convert the\n");
  printf("output data to text format for viewing.\n\n");
  printf("This simple experiment just shows the\n");
  printf("response of a modulatory neuron, when it\n");
  printf("receives a singe US spike.\n");
}

