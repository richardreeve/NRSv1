// Experiment to demonstrate a ModulatorySynapse sensitizing a
// ConditionableSynapse.

//
// Darren Smith
// University of Edinburgh, 2003

#include <defines.n>

Network System
{  
  SetParams
    {
      // Speed up the simulation by using a larger step size
      stepT = 1 ms;
    }

  add neuron reinforcer SpikeSource
      {
        spikeTime = 600 ms;
      }  


  add neuron test SpikeSource
    {
      spikeTime = 300 ms;
      spikePeriod = 400 ms;
    }  

  // Nothing special about the post-synaptic neuron.  Make it default.
  add neuron postN Spiking
    {
    }

  
  add synapse
    {
      cond_syn ConditionableSynapse from test to postN
        {
          facDecayT = 1000 mS;
          //          pSynG = 10 nS;
        }
    }
  
  add synapse
    {
      mod_syn ModulatorySynapse from reinforcer to cond_syn
        {
          /* default values */
          mModStr = 2 nS;
        }
    }
}


Experiment
{
  Time = 1 s;

  printf("sensitized_epsp.n demo script loaded\n");
  
  // Output lots of information
  output_level = output_input | 
                 output_spike |
                 output_membV |  
                 output_synapse;

  Save
  {
    Level = output_level;
    Start("~/data/sensitized_epsp");
  }

  printf("Running experiment...\n\n");
  Run;
  wait;
  printf("\nExperiment completed\n--------------------\n");
  printf("Use the nodeHelper.linux tool to convert the\n");
  printf("output data to text format for viewing.\n\n");
  printf("\n");
  printf("WHAT YOU SHOULD SEE\n");
  printf("In the log file you should see a pair of excitatory\n");
  printf("post-synaptic potentials.  The first is before sensitization and\n");
  printf("the second is after.  The second trace shows a much larger\n");
  printf("response.\n\n");
}

