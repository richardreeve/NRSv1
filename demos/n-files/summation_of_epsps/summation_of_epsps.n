// Experiment to sum a train of psps



#include <defines.n>

Network System
{  
  SetParams
    {
      // Speed up the simulation by using a larger step size
      stepT = 1 ms;
    }
 
  /* ------------------------------------------------------------------ */
  /* FACTORY SETTINGS                                                   */
  /*                                                                    */
  /* To get nice output data, set the following parameter / value pairs */
  /*                                                                    */
  /*     stepT = 1 ms;                                                  */
  /*     membC_coeff = 5;                                               */
  /*     Time = 1 s;                                                    */
  /*                                                                    */
  /*     expSynT = 100 ms;                                              */
  /*     evSynV = -50 mV;                                               */
  /*     vSynG = 4 nS;                                                  */
  /*                                                                    */
  /* ------------------------------------------------------------------ */

  int membC_coeff = 5;

  // Spike source
  add neuron preN Spiking
    {
      membV = 0 mV;
      threshV = -1 mV;
      recovV = -40 mV;
      
      membG = 5 nS;
      membC = membC_coeff * 10 pF;
    }  

  add neuron postN Spiking
    {
      threshV = 0 mV;
    }

  add synapse
    {
      syn ConductanceBased excitatory from preN to postN delay 5
        {
          /* default values */
          expSynT = 100 ms;
          evSynV = -50 mV;
          vSynG = 4 nS;
        }
    }  
}


Experiment
{
  Time = 1 s;

  printf("summation_of_epsps.n demo script loaded\n");
  
  // Output lots of information
  output_level = output_input | output_spike | output_membV;

  Save
  {
    Level = output_level;
    Start("~/data/summation_of_epsps");
  }

  printf("Running experiment...\n\n");
  Run;
  wait;
  printf("\nExperiment completed\n--------------------\n");
  printf("Use the nodeHelper.linux tool to convert the\n");
  printf("output data to text format for viewing.\n\n");

  printf("WHAT YOU SHOULD SEE\n");
  printf("There are many EPSPs summed together, but, because the battery\n");
  printf("potential of the synapse (also called the reversal potential)\n");
  printf("is less than the threshold, the target neuron never fires.\n");


}

