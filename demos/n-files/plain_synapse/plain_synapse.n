// Experiment to demonstrate the PlainSynapse functionality

#include <defines.n>

Network System
{  
  SetParams
    {
      // Speed up the simulation by using a larger step size
      stepT = 1 ms;
    }
 
  add neuron preN SpikeSource
    {
      spikeTime = 100 ms;
      spikePeriod = 400 ms;
    }

  add neuron postN Spiking
    {
      /* defaults

      membC = 10 pF
      membG = 5 nS
      */

      membC = 5 pF;
      membG = 10 nS;
    }

  add synapse
    {
      syn PlainSynapse from preN to postN delay 5
        {
          /* default values */
          expSynT = 100 ms;
          pSynE = -40 mV;
          pSynG = 1 nS;
        }
    }  
}


Experiment
{
  Time = 1 s;

  printf("plain_synapse.n demo script loaded\n");
  
  // Output lots of information
  output_level = output_input | 
                 output_spike | 
                 output_membV | 
                 output_membG | 
                 output_synapse |
		 output_facdep;

  Save
  {
    Level = output_level;
    Start("~/data/plain_synapse");
  }

  printf("Running experiment...\n\n");
  Run;
  wait;
  printf("\nExperiment completed\n--------------------\n");
  printf("Use the nodeHelper.linux tool to convert the\n");
  printf("output data to text format for viewing.\n\n");
}

